# Copy this file to .env.local and fill in your values

# Email Notifications (use Gmail App Password)
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-16-char-app-password
ADMIN_EMAIL=admin@mlrit.edu

# Optional: Resend (transactional email)
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# Optional: Database
# DATABASE_URL=postgresql://user:password@host:5432/mlrit_admissions

# Optional: Firebase Storage for Resume Upload
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
